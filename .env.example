# Admin backend configuration
JWT_SECRET=change-me-in-production

# Default admin account seeded into the SQLite DB on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=meantgo-admin

# MeantGo Admin API (Fydinn = current test deployment)
MEANTGO_API=https://fydinn.up.railway.app
# Paste the shared Fydinn admin token here to enable monitoring/analytics/moderation
MEANTGO_ADMIN_TOKEN=

# Postgres connection (set in Vercel / your host)
DATABASE_URL=
